# syntax=docker/dockerfile:1
# GraalVM native 可执行文件 → 极简运行镜像
# 需先在 CI/本地执行：./mvnw -Pnative -DskipTests native:compile
# 产物：target/device-manager（Spring Boot native 可执行文件）

FROM debian:bookworm-slim

WORKDIR /app

# 非 root 运行；装 iputils 提供 ping（PING 监控模式需要），并授予 CAP_NET_RAW
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && setcap cap_net_raw+ep /bin/ping \
    && useradd -r -u 10001 app \
    && mkdir -p /app/data \
    && chown -R app:app /app

COPY --chown=app:app target/device-manager /app/app

ENV SPRING_PROFILES_ACTIVE=docker \
    SPRING_DATASOURCE_URL="jdbc:sqlite:/app/data/data.db" \
    APP_SCRIPT_MASTER_KEY_FILE="/app/data/.master-key" \
    APP_SERVER_URL="http://localhost:8080"

VOLUME ["/app/data"]
EXPOSE 8080
USER app

ENTRYPOINT ["/app/app"]
